{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"useAwait": "warn"
			},
			"style": {
				"useConsistentArrayType": "warn",
				"useImportType": "warn",
				"useExportType": "warn",
				"noNonNullAssertion": "off",
				"noParameterAssign": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120
	}
}
